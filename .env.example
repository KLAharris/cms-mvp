# CMS MVP local Docker Compose configuration.
# Copy this file to .env and replace placeholders before running Compose.

# PostgreSQL 15
POSTGRES_USER=cms
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=cms

# NestJS API
DATABASE_URL=postgresql://cms:replace-with-local-postgres-password@postgres:5432/cms
NODE_ENV=production
PORT=3000

# ── Email ────────────────────────────────────────────────────────────────────
# Which email provider to use.
# Values: ses | smtp | resend | console
# - ses     → AWS SES via SMTP (uses SMTP_* vars below)
# - smtp    → Generic SMTP relay (uses SMTP_* vars below)
# - resend  → Resend API (uses RESEND_API_KEY below)
# - console → No-op, logs to stdout. Use in dev and CI.
EMAIL_PROVIDER=console

EMAIL_FROM=no-reply@cms.example.com
EMAIL_FROM_NAME=CMS
RESEND_FROM_ADDRESS="CMS <no-reply@cms.example.com>"

# Required when EMAIL_PROVIDER=ses or EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_SECURE=true

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re___CHANGE_ME__

# Base URL of the admin SPA — used to build invite links (OPS-ARCH: PUBLIC_URL)
PUBLIC_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
WORKER_SCHEDULED_PUBLISH_INTERVAL_SEC=30

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cms-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000/cms-media
MAX_UPLOAD_BYTES=20971520
PRESIGN_TTL_SECONDS=300

# Redis 7 / BullMQ
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@redis:6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=replace-with-local-minio-user
S3_SECRET_ACCESS_KEY=replace-with-local-minio-password
