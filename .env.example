# CMS MVP local Docker Compose configuration.
# Copy this file to .env and replace placeholders before running Compose.

# PostgreSQL 15
POSTGRES_USER=cms
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=cms

# NestJS API
DATABASE_URL=postgresql://cms:replace-with-local-postgres-password@postgres:5432/cms
NODE_ENV=production
PORT=3000

# Redis 7 / BullMQ
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@redis:6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=cms-media
S3_ACCESS_KEY_ID=replace-with-local-minio-user
S3_SECRET_ACCESS_KEY=replace-with-local-minio-password
