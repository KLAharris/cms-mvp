generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  INVITED
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  name                       String
  passwordHash               String
  role                       Role
  status                     UserStatus @default(ACTIVE)
  lastLoginAt                DateTime?
  inviteTokenHash            String?
  inviteExpiresAt            DateTime?
  failedLoginAttempts        Int       @default(0)
  failedLoginWindowStartedAt DateTime?
  lockedUntil                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  contents                   Content[]
}

enum ContentType {
  article
  page
}

enum ContentStatus {
  draft
  in_review
  published
  unpublished
  archived
}

model Content {
  id              String        @id @default(uuid())
  type            ContentType
  title           String
  slug            String
  body            Json?
  status          ContentStatus @default(draft)
  authorId        String        @map("author_id")
  featuredImageId String?       @map("featured_image_id")
  socialImageId   String?       @map("social_image_id")
  seoTitle        String        @default("") @map("seo_title")
  seoDescription  String        @default("") @map("seo_description")
  tags            String[]
  category        String?
  parentId        String?       @map("parent_id")
  scheduledAt     DateTime?     @map("scheduled_at")
  publishedAt     DateTime?     @map("published_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  author   User             @relation(fields: [authorId], references: [id])
  versions ContentVersion[]

  @@unique([type, slug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId, status])
  @@map("content")
}

model ContentVersion {
  id        String   @id @default(uuid())
  contentId String   @map("content_id")
  versionNo Int      @map("version_no")
  snapshot  Json
  editorId  String   @map("editor_id")
  createdAt DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id])

  @@unique([contentId, versionNo])
  @@map("content_version")
}
