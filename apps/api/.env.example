# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/cms

# Separate connection string for tests (use a different branch/database)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/cms_test

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# Secret used to sign JWTs — generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL — used by auth (token blocklist), media (BullMQ), public-api (cache)
REDIS_URL=redis://localhost:6379

# If using password-protected Redis, include credentials in the URL:
# REDIS_URL=redis://:your-password@localhost:6379

# ─── Application ──────────────────────────────────────────────────────────────
# Node environment: development | production | test
NODE_ENV=development

# Port the API server listens on
PORT=3000

# Public-facing base URL of this API server (used in email links)
PUBLIC_URL=http://localhost:3000

# ─── Object Storage (S3-compatible) ──────────────────────────────────────────
# S3-compatible endpoint — use http://localhost:9000 for local MinIO
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# AWS region or MinIO region
OBJECT_STORAGE_REGION=us-east-1

# S3 bucket name
OBJECT_STORAGE_BUCKET=cms-media

# Access key ID
OBJECT_STORAGE_ACCESS_KEY=minioadmin

# Secret access key
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Public URL prefix for served media files
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000/cms-media

# Maximum upload size in bytes (default: 20 MB)
MAX_UPLOAD_BYTES=20971520

# Presigned URL TTL in seconds (default: 300 s)
PRESIGN_TTL_SECONDS=300

# ─── Email ────────────────────────────────────────────────────────────────────
# Email provider: console | smtp | resend | ses
# Use "console" for local dev (logs emails to stdout instead of sending)
EMAIL_PROVIDER=console

# From address shown in outgoing emails
EMAIL_FROM=no-reply@cms.example.com

# Display name for the from address
EMAIL_FROM_NAME=CMS

# Frontend base URL — used in email links (password reset, invite)
FRONTEND_BASE_URL=http://localhost:5173

# ─── SMTP (required when EMAIL_PROVIDER=smtp) ────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_SECURE=false

# ─── Resend (required when EMAIL_PROVIDER=resend) ────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_ADDRESS=no-reply@yourdomain.com

# ─── Workers ─────────────────────────────────────────────────────────────────
# How often the scheduled-publish worker polls for articles to publish (seconds)
WORKER_SCHEDULED_PUBLISH_INTERVAL_SEC=30
